# Cozy Blissful Email Engine Configuration
# Copy to .env and fill in your credentials

# ===========================================
# SMTP Transport Configuration
# ===========================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465 (SSL), false for 587 (STARTTLS)
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ===========================================
# Sender Identity (SPF/DKIM/DMARC alignment)
# ===========================================
MAIL_FROM_ADDRESS=noreply@cozyblissful.com
MAIL_FROM_NAME="Cozy Blissful Spa & Salon"
MAIL_REPLY_TO=support@cozyblissful.com

# ===========================================
# DKIM Signing (required for DMARC alignment)
# ===========================================
DKIM_DOMAIN=cozyblissful.com
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY_PATH=./keys/dkim-private.key
DKIM_KEY_PASSPHRASE=  # optional, if key is encrypted

# ===========================================
# Frontend URLs (for CTA links in emails)
# ===========================================
FRONTEND_URL=https://cozyblissful.com
UNSUBSCRIBE_BASE_URL=https://cozyblissful.com/unsubscribe

# ===========================================
# Salon Configuration
# ===========================================
SALON_NAME="Cozy Blissful Spa & Salon"
SALON_ADDRESS="Cozy Blissful Spa & Wellness, Metro Manila"
SALON_PHONE="+63 999 543 5913"
SALON_WHATSAPP="https://wa.me/639995435913"
SALON_HOURS="9:00 AM – 9:00 PM, Daily"

# ===========================================
# Rate Limiting & Connection Pooling
# ===========================================
# Max concurrent connections to SMTP server
SMTP_POOL_MAX_CONNECTIONS=5
# Max messages per connection before reconnecting
SMTP_POOL_MAX_MESSAGES=100
# Rate limit: max messages per second
RATE_LIMIT_MESSAGES_PER_SECOND=10
# Rate limit: max messages per minute
RATE_LIMIT_MESSAGES_PER_MINUTE=100

# ===========================================
# Retry Configuration
# ===========================================
RETRY_ATTEMPTS=3
RETRY_MIN_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
RETRY_FACTOR=2

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_PRETTY=true

# ===========================================
# Template Configuration
# ===========================================
TEMPLATE_DIR=./templates
# Auto-generate plaintext from HTML
AUTO_GENERATE_PLAINTEXT=true

# ===========================================
# Queue Configuration (optional, for BullMQ/Redis)
# ===========================================
# QUEUE_REDIS_URL=redis://localhost:6379
# QUEUE_NAME=email-sending