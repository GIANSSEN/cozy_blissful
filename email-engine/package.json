{
  "name": "cozy-blissful-email-engine",
  "version": "1.0.0",
  "description": "Production SMTP engine for Cozy Blissful Spa & Salon email templates",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/cli.js",
    "send:approval": "node src/cli.js send-approval",
    "send:confirmation": "node src/cli.js send-confirmation",
    "send:test": "node src/cli.js send-test",
    "health": "node src/cli.js health",
    "dkim:generate": "node scripts/generate-dkim.js",
    "lint": "eslint src/",
    "prettier": "prettier --write src/ templates/",
    "dev": "node --watch src/cli.js"
  },
  "keywords": [
    "email",
    "smtp",
    "nodemailer",
    "transactional",
    "spa",
    "salon"
  ],
  "author": "Cozy Blissful",
  "license": "MIT",
  "dependencies": {
    "nodemailer": "^6.9.14",
    "handlebars": "^4.7.8",
    "html-to-text": "^9.0.5",
    "dotenv": "^16.4.5",
    "commander": "^12.1.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.2.0",
    "dkim-signer": "^0.2.1",
    "async-retry": "^1.3.3",
    "bottleneck": "^2.19.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "eslint": "^9.5.0",
    "prettier": "^3.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}